{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-insight.local/schemas/artifacts/summary.schema.json",
  "title": "Resumo do conteúdo (summary_json_key)",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "content_kind": {
      "enum": ["meeting", "lecture", "tutorial", "interview", "presentation", "other"]
    },
    "text": { "type": "string", "minLength": 1, "description": "Resumo em Markdown." }
  }
}
