{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-insight.local/schemas/processing-started.schema.json",
  "title": "processing.started",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "correlation_id", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "processing.started" },
    "event_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "video_id", "attempt", "worker_id"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "video_id": { "type": "string", "format": "uuid" },
        "attempt": { "type": "integer", "minimum": 1 },
        "worker_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
