{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-insight.local/schemas/processing-progressed.schema.json",
  "title": "processing.progressed",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "correlation_id", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "processing.progressed" },
    "event_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "video_id", "attempt", "stage", "progress_percent"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "video_id": { "type": "string", "format": "uuid" },
        "attempt": { "type": "integer", "minimum": 1 },
        "stage": {
          "enum": [
            "downloading",
            "extracting_audio",
            "transcribing",
            "summarizing",
            "creating_chapters",
            "uploading_artifacts"
          ]
        },
        "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "message": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
