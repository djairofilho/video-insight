global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
  - job_name: video-service
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: [__AWS_VIDEO_PRIVATE_HOST__:8081]
  - job_name: job-service
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: [__AWS_JOB_PRIVATE_HOST__:8081]
  - job_name: processing-service
    metrics_path: /metrics
    static_configs:
      - targets: [__AWS_PROCESSING_PRIVATE_HOST__:8081]
  - job_name: nodes
    static_configs:
      - targets: [__AWS_DOCKER_BRIDGE_HOST__:19101]
        labels: {role: gateway}
      - targets: [__AWS_DOCKER_BRIDGE_HOST__:19102]
        labels: {role: video}
      - targets: [__AWS_JOB_PRIVATE_HOST__:9100]
        labels: {role: job}
      - targets: [__AWS_DOCKER_BRIDGE_HOST__:19103]
        labels: {role: processing}
      - targets: [__AWS_DOCKER_BRIDGE_HOST__:19104]
        labels: {role: core}
  - job_name: gateway
    static_configs:
      - targets: [__AWS_DOCKER_BRIDGE_HOST__:19111]
        labels: {role: gateway}
