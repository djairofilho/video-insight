{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Video Insight API Gateway",
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "0s",
  "max_idle_connections": 128,
  "max_idle_connections_per_host": 64,
  "idle_connection_timeout": "90s",
  "dialer_keep_alive": "30s",
  "extra_config": {
    "telemetry/opentelemetry": {
      "service_name": "video-insight-gateway",
      "metric_reporting_period": 15,
      "exporters": {
        "prometheus": [{"name": "private", "port": 9091, "process_metrics": true, "go_metrics": false}]
      }
    },
    "router": {
      "auto_options": true
    },
    "security/cors": {
      "allow_origins": __FRONTEND_ORIGINS_JSON__,
      "allow_methods": [
        "GET",
        "POST",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "*"
      ],
      "options_passthrough": true,
      "allow_credentials": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/health/video",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/health/jobs",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/health/processing",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": [
            "http://__AWS_PROCESSING_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Authorization"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "limit",
        "cursor"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}",
      "method": "DELETE",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/upload-url",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/upload-url",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/upload-complete",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Authorization"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/upload-complete",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/playback-url",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/playback-url",
          "encoding": "no-op",
          "host": [
            "http://__AWS_VIDEO_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/jobs",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Idempotency-Key",
        "Authorization"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/jobs",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/jobs",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "limit",
        "cursor"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/jobs",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/cancel",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/cancel",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/retry",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/retry",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/result",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/result",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/transcript",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "format"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/transcript",
          "encoding": "no-op",
          "host": [
            "http://__AWS_JOB_PRIVATE_HOST__:8081"
          ]
        }
      ],
      "input_headers": [
        "Authorization"
      ]
    }
  ]
}
