      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/result",
          "encoding": "no-op",
          "host": [
            "http://172.31.7.191:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/transcript",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "format"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/transcript",
          "encoding": "no-op",
