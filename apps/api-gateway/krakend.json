            "http://172.31.1.54:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}/jobs",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Idempotency-Key"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}/jobs",
          "encoding": "no-op",
          "host": [
            "http://172.31.7.191:8081"
          ]
        }
      ]
    },
    {
