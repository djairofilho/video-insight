      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}",
          "encoding": "no-op",
          "host": [
            "http://172.31.7.191:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/jobs/{jobId}/cancel",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/jobs/{jobId}/cancel",
          "encoding": "no-op",
          "host": [
            "http://172.31.7.191:8081"
          ]
        }
      ]
    },
    {
