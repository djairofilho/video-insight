{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Video Insight API Gateway",
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "0s",
  "extra_config": {
    "router": {
      "auto_options": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "DELETE", "OPTIONS"],
      "allow_headers": ["*"],
      "options_passthrough": true,
      "allow_credentials": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/health/video",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": ["http://172.31.1.54:8081"]
        }
      ]
    },
    {
      "endpoint": "/health/jobs",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": ["http://172.31.7.191:8081"]
        }
      ]
    },
    {
      "endpoint": "/health/processing",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "json",
          "host": ["http://172.31.14.236:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos",
          "encoding": "no-op",
          "host": [
            "http://172.31.1.54:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": [
        "limit",
        "cursor"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/videos",
          "encoding": "no-op",
          "host": [
            "http://172.31.1.54:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/videos/{videoId}",
          "encoding": "no-op",
          "host": [
            "http://172.31.1.54:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/videos/{videoId}",
      "method": "DELETE",
      "output_encoding": "no-op",
      "backend": [
