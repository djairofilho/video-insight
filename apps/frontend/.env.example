# Copie para .env.local (ignorado pelo Git) e ajuste os valores.
# URL pública do API Gateway, incluindo o prefixo /api/v1.
# Na AWS: http://3.227.9.20:8081/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Auth0 (etapa 3). Com VITE_AUTH0_DOMAIN vazio, as rotas ficam abertas.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
